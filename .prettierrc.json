{
    "semi": true,
    "singleQuote": true,
    "tabWidth": 4,
    "trailingComma": "all",
    "printWidth": 100,
    "bracketSpacing": true,
    "arrowParens": "always",
    "endOfLine": "auto",
    "vueIndentScriptAndStyle": true,
    "plugins": ["@trivago/prettier-plugin-sort-imports", "prettier-plugin-tailwindcss"],
    "importOrder": [
        "^node:(.*)$",
        "^vue$",
        "^vue-router$",
        "^pinia$",
        "<THIRD_PARTY_MODULES>",
        "^@/types/(.*)$",
        "^@/(.*)$",
        "^\\.\\./(.*)$",
        "^\\./(.*)$",
        "^.+\\.(css|scss|less|sass)$"
    ],
    "importOrderSeparation": true,
    "importOrderSortSpecifiers": true
}
