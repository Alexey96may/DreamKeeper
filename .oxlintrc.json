{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["eslint", "typescript", "unicorn", "oxc", "vue", "vitest"],
    "env": {
        "browser": true,
        "node": true
    },
    "rules": {
        "no-console": ["warn", { "allow": ["error", "warn"] }],
        "eqeqeq": "warn",
        "vitest/require-mock-type-parameters": "off"
    },
    "categories": {
        "correctness": "error"
    }
}
