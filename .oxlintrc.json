{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["eslint", "typescript", "unicorn", "oxc", "vue", "vitest"],
    "env": {
        "browser": true,
        "node": true
    },
    "rules": {
        "no-console": "error",
        "eqeqeq": "warn"
    },
    "categories": {
        "correctness": "error"
    }
}
